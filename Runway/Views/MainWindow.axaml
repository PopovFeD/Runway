<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Runway.ViewModels"
        xmlns:tr="using:Runway.Transport"
        x:Class="Runway.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/oopf.ico"
        Title="Runway"
        MinWidth="760" MinHeight="480">

    <!-- Каркас по GUI-макету (Misc/gui_mockups/): постоянные верхняя панель,
    сайдбар навигации и нижняя статус-панель; контент — вкладками.
    Функционал только существующий: подключение + живой вывод (LogEntries).
    Команды/Экспорт/Настройки — заглушки до разделения ViewModel. -->

    <Window.Styles>
        <!-- Полупрозрачные фоны/рамки — одинаково приличны в светлой и тёмной теме -->
        <Style Selector="Border.bar">
            <Setter Property="Background" Value="#20808080"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="BorderBrush" Value="#60808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="TextBlock.tileTitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="TextBlock.tileValue">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style Selector="ListBox.terminal">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="ListBox.terminal ListBoxItem">
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TextBlock.stub">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ: индикатор реального соединения + кнопка вкл/выкл.
        Имени приложения тут нет — оно и так в заголовке окна. -->
        <Border DockPanel.Dock="Top" Classes="bar">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{Binding Connection.ToggleConnectionText}"
                        Command="{Binding Connection.ToggleConnectionCommand}"/>
                <TextBlock VerticalAlignment="Center" Text="{Binding Connection.StatusText}"/>
            </DockPanel>
        </Border>

        <!-- НИЖНЯЯ СТАТУС-ПАНЕЛЬ -->
        <Border DockPanel.Dock="Bottom" Classes="bar" Padding="12,4">
            <DockPanel>
                <TextBlock FontSize="12" Text="{Binding Connection.StatusText}"/>
                <TextBlock DockPanel.Dock="Right" FontSize="12"
                           HorizontalAlignment="Right"
                           Text="{Binding LogEntries.Count, StringFormat='Записей в выводе: {0}'}"/>
            </DockPanel>
        </Border>

        <!-- САЙДБАР (вкладки слева) + ОСНОВНОЕ ОКНО -->
        <TabControl TabStripPlacement="Left" Padding="12,8">

            <TabItem Header="Дашборд">
                <DockPanel>
                    <!-- Последние принятые значения по каждому типу пакета -->
                    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,10">
                        <Border Classes="tile" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Classes="tileTitle" Text="Температура"/>
                                <TextBlock Classes="tileValue" Text="{Binding LastTemperatureText}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="tile" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Classes="tileTitle" Text="Влажность"/>
                                <TextBlock Classes="tileValue" Text="{Binding LastHumidityText}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="tile" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Classes="tileTitle" Text="Давление"/>
                                <TextBlock Classes="tileValue" Text="{Binding LastPressureText}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="tile">
                            <StackPanel>
                                <TextBlock Classes="tileTitle" Text="Освещённость"/>
                                <TextBlock Classes="tileValue" Text="{Binding LastLightText}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock DockPanel.Dock="Top" Classes="tileTitle"
                               Text="Живой вывод · последние записи" Margin="0,0,0,4"/>

                    <!-- Живой вывод в терминальном стиле (см. мокап): тёмный фон,
                    плотные строки, автопрокрутка вниз — код в MainWindow.axaml.cs -->
                    <ListBox x:Name="LiveOutput" Classes="terminal"
                             ItemsSource="{Binding LogEntries}"
                             FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Подключение">
                <StackPanel Spacing="10" Margin="4">
                    <TextBlock Text="Транспорт" Classes="tileTitle"/>
                    <ComboBox MinWidth="220"
                              ItemsSource="{Binding Connection.Transports}"
                              SelectedItem="{Binding Connection.SelectedTransport}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="tr:ITransport">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Точка подключения" Classes="tileTitle"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox MinWidth="220"
                                  ItemsSource="{Binding Connection.AvailableEndpoints}"
                                  SelectedItem="{Binding Connection.SelectedEndpoint}"/>
                        <Button Content="Обновить список" Command="{Binding Connection.RefreshEndpointsCommand}"/>
                    </StackPanel>


                    <TextBlock Text="{Binding Connection.StatusText}" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Команды">
                <TextBlock Classes="stub"
                           Text="Заглушка. Управляющие команды появятся вместе с CommandsViewModel — PacketBuilder уже умеет собирать кадры (Ping/Telemetry/Environment)."/>
            </TabItem>

            <TabItem Header="Экспорт">
                <StackPanel Margin="16" Spacing="8">
                    <Button Content="Экспортировать все записи" IsEnabled="False"/>
                    <Button Content="Экспортировать эту сессию" IsEnabled="False"/>
                    <TextBlock Classes="stub" Margin="0"
                               Text="Заглушка. CSV будет первым (SqliteTelemetryStore.ReadAll уже готов), Excel — позже."/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Логи">
                <DockPanel>
                    <!-- Галочки-фильтры: каждая отвечает за свой тип сообщений.
                    Что выбрано — то показывается и то же экспортируется.
                    Чтение из SQLite (events) по кнопке; живой поток — на Дашборде -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                Spacing="12" Margin="0,0,0,8">
                        <CheckBox Content="Info" IsChecked="{Binding Logs.ShowInfo}"/>
                        <CheckBox Content="Warning" IsChecked="{Binding Logs.ShowWarning}"/>
                        <CheckBox Content="Error" IsChecked="{Binding Logs.ShowError}"/>
                        <CheckBox Content="Только текущая сессия"
                                  IsChecked="{Binding Logs.OnlyCurrentSession}"/>
                        <Button Content="Обновить" Command="{Binding Logs.RefreshLogsCommand}"/>
                        <Button Content="Экспорт" Command="{Binding Logs.ExportLogsCommand}"/>
                    </StackPanel>

                    <!-- Результат последнего экспорта: путь к файлу или ошибка -->
                    <TextBlock DockPanel.Dock="Bottom" Classes="tileTitle"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{Binding Logs.ExportStatusText}"/>

                    <ListBox ItemsSource="{Binding Logs.FilteredLogEvents}"
                             FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Настройки">
                <TextBlock Classes="stub"
                           Text="Заглушка. Здесь будет редактирование settings.json (порт, скорость, пути логов и БД, поведение переподключения) и сброс к значениям по умолчанию."/>
            </TabItem>

        </TabControl>
    </DockPanel>

</Window>
