<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Runway.ViewModels"
        xmlns:tr="using:Runway.Transport"
        x:Class="Runway.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Runway">

    <DockPanel Margin="8">
        <!-- Панель подключения: транспорт → точка подключения → кнопки.
        Доступность кнопок управляется CanExecute команд во ViewModel,
        в разметке никакой логики нет. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <ComboBox MinWidth="140"
                      ItemsSource="{Binding Transports}"
                      SelectedItem="{Binding SelectedTransport}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="tr:ITransport">
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox MinWidth="140"
                      ItemsSource="{Binding AvailableEndpoints}"
                      SelectedItem="{Binding SelectedEndpoint}"/>

            <Button Content="Обновить список" Command="{Binding RefreshEndpointsCommand}"/>
            <Button Content="Подключить" Command="{Binding ConnectCommand}"/>
            <Button Content="Отключить" Command="{Binding DisconnectCommand}"/>

            <!-- Показывает реальное соединение (транспорт + точка), а не текущий
            выбор в ComboBox — их легко рассинхронизировать, просто листая список -->
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding LogEntries}"/>
    </DockPanel>

</Window>
