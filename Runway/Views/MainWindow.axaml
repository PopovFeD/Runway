<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Runway.ViewModels"
        xmlns:tr="using:Runway.Transport"
        x:Class="Runway.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/oopf.ico"
        Title="Runway"
        MinWidth="760" MinHeight="480">

    <!-- Каркас по GUI-макету (Misc/gui_mockups/): постоянные верхняя панель,
    сайдбар навигации и нижняя статус-панель; контент — вкладками.
    Заглушкой осталась только вкладка "Команды". -->

    <Window.Styles>
        <!-- Полупрозрачные фоны/рамки — одинаково приличны в светлой и тёмной теме -->
        <Style Selector="Border.bar">
            <Setter Property="Background" Value="#20808080"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="BorderBrush" Value="#60808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="TextBlock.tileTitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="TextBlock.tileValue">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style Selector="ListBox.terminal">
            <!-- Автоматически подстраивается под светлую/тёмную тему -->
            <Setter Property="Background"
                    Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="ListBox.terminal ListBoxItem">
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TextBlock.stub">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ: индикатор реального соединения + кнопка вкл/выкл.
        Имени приложения тут нет — оно и так в заголовке окна. -->
        <Border DockPanel.Dock="Top" Classes="bar">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{Binding Connection.ToggleConnectionText}"
                        Command="{Binding Connection.ToggleConnectionCommand}"/>
                <TextBlock VerticalAlignment="Center" Text="{Binding Connection.StatusText}"/>
            </DockPanel>
        </Border>

        <!-- НИЖНЯЯ СТАТУС-ПАНЕЛЬ -->
        <Border DockPanel.Dock="Bottom" Classes="bar" Padding="12,4">
            <DockPanel>
                <TextBlock FontSize="12" Text="{Binding Connection.StatusText}"/>
                <TextBlock DockPanel.Dock="Right" FontSize="12"
                           HorizontalAlignment="Right"
                           Text="{Binding LogEntries.Count, StringFormat='Записей в выводе: {0}'}"/>
            </DockPanel>
        </Border>

        <!-- САЙДБАР (вкладки слева) + ОСНОВНОЕ ОКНО -->
        <TabControl TabStripPlacement="Left" Padding="12,8">

            <TabItem Header="Дашборд">
                <!-- Верх: разделы плиток по протоколам; низ: терминал.
                GridSplitter между ними таскается, высоты меняются -->
                <Grid RowDefinitions="2*,4,3*">

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProtocolSectionViewModel">
                                    <StackPanel IsVisible="{Binding IsVisible}" Margin="0,0,0,10">
                                        <!-- Заголовок раздела мелкий — не нарушает плиточность -->
                                        <TextBlock Classes="tileTitle" FontSize="11"
                                                   Text="{Binding Header}" Margin="2,0,0,3"/>
                                        <ItemsControl ItemsSource="{Binding Tiles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TileViewModel">
                                                    <Border Classes="tile" Margin="0,0,8,8" MinWidth="150">
                                                        <StackPanel>
                                                            <TextBlock Classes="tileTitle" Text="{Binding Title}"/>
                                                            <TextBlock Classes="tileValue" Text="{Binding Value}"/>
                                                            <!-- Время обновления внизу карточки, как в макете -->
                                                            <TextBlock Classes="tileTitle" FontSize="10"
                                                                       Text="{Binding UpdatedAtText}" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                                  Background="#40808080" ResizeDirection="Rows"/>

                    <!-- Терминал + кнопка слежения поверх него (как "прокрутить вниз"
                    на сайтах). Автопрокрутка работает только при нажатой кнопке -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <ListBox x:Name="LiveOutput" Classes="terminal"
                                 ItemsSource="{Binding LogEntries}"
                                 FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"/>
                        <ToggleButton IsChecked="{Binding FollowTail}"
                                      Content="⤓" FontSize="14" Padding="8,2"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Margin="0,0,18,10" Opacity="0.85"
                                      ToolTip.Tip="Следовать за последними записями"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Подключение">
                <StackPanel Spacing="10" Margin="4">
                    <TextBlock Text="Транспорт" Classes="tileTitle"/>
                    <ComboBox MinWidth="220"
                              ItemsSource="{Binding Connection.Transports}"
                              SelectedItem="{Binding Connection.SelectedTransport}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="tr:ITransport">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Точка подключения" Classes="tileTitle"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox MinWidth="220"
                                  ItemsSource="{Binding Connection.AvailableEndpoints}"
                                  SelectedItem="{Binding Connection.SelectedEndpoint}"/>
                        <Button Content="Обновить список" Command="{Binding Connection.RefreshEndpointsCommand}"/>
                    </StackPanel>


                    <TextBlock Text="{Binding Connection.StatusText}" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Команды">
                <TextBlock Classes="stub"
                           Text="Заглушка. Управляющие команды появятся вместе с CommandsViewModel — PacketBuilder уже умеет собирать кадры (Ping/Telemetry/Environment)."/>
            </TabItem>

            <TabItem Header="Экспорт">
                <!-- По макету: формат + «все записи» / «эта сессия» + счётчик.
                Экспортируется телеметрия; экспорт логов — во вкладке "Логи" -->
                <StackPanel Margin="4" Spacing="10" HorizontalAlignment="Left">
                    <TextBlock Text="Формат" Classes="tileTitle"/>
                    <ComboBox MinWidth="180"
                              ItemsSource="{Binding Export.Formats}"
                              SelectedItem="{Binding Export.SelectedFormat}"/>

                    <TextBlock Text="Протоколы" Classes="tileTitle"/>
                    <!-- XLSX: лист на протокол в одной книге; CSV: файл на протокол -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox Content="Telemetry (0x10)"
                                  IsChecked="{Binding Export.IncludeTelemetry}"/>
                        <CheckBox Content="Environment (0x11)"
                                  IsChecked="{Binding Export.IncludeEnvironment}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Экспортировать все записи"
                                Command="{Binding Export.ExportAllCommand}"/>
                        <Button Content="Экспортировать эту сессию"
                                Command="{Binding Export.ExportSessionCommand}"/>
                    </StackPanel>

                    <TextBlock Classes="tileTitle" Text="{Binding Export.TotalRecordsText}"/>
                    <TextBlock Classes="tileTitle" TextWrapping="Wrap" MaxWidth="520"
                               Text="{Binding Export.StatusText}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Логи">
                <DockPanel>
                    <!-- Галочки-фильтры: каждая отвечает за свой тип сообщений.
                    Что выбрано — то показывается и то же экспортируется.
                    Чтение из SQLite (events) по кнопке; живой поток — на Дашборде -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                Spacing="12" Margin="0,0,0,8">
                        <CheckBox Content="Info" IsChecked="{Binding Logs.ShowInfo}"/>
                        <CheckBox Content="Warning" IsChecked="{Binding Logs.ShowWarning}"/>
                        <CheckBox Content="Error" IsChecked="{Binding Logs.ShowError}"/>
                        <CheckBox Content="Только текущая сессия"
                                  IsChecked="{Binding Logs.OnlyCurrentSession}"/>
                        <Button Content="Обновить" Command="{Binding Logs.RefreshLogsCommand}"/>
                        <Button Content="Экспорт" Command="{Binding Logs.ExportLogsCommand}"/>
                    </StackPanel>

                    <!-- Результат последнего экспорта: путь к файлу или ошибка -->
                    <TextBlock DockPanel.Dock="Bottom" Classes="tileTitle"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{Binding Logs.ExportStatusText}"/>

                    <ListBox ItemsSource="{Binding Logs.FilteredLogEvents}"
                             FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Настройки">
                <StackPanel Margin="4" Spacing="8">
                    <TextBlock Text="Разделы Дашборда" Classes="tileTitle"/>
                    <!-- Какие протоколы показывать плитками; выбор сохраняется
                    в settings.json (подписка на IsVisible — в App.axaml.cs) -->
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProtocolSectionViewModel">
                                <CheckBox Content="{Binding Header}"
                                          IsChecked="{Binding IsVisible}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="stub" Margin="0"
                               Text="Остальные настройки (порт, скорость, пути) — по-прежнему в settings.json; редактор и сброс появятся позже."/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>

</Window>
